{
  "name": "posterium-frontend",
  "compatibility_date": "2026-08-01",

  "assets": {
    "directory": "./dist/",
    "not_found_handling": "404-page",
    // Normalize URLs for better SEO and to prevent duplicate content
    "html_handling": "drop-trailing-slash",
  },

  "env": {
    "staging": {
      "workers_dev": true,
    },
    "production": {
      "workers_dev": false,
      "routes": [
        {
          "pattern": "posterium.xyz",
          "custom_domain": true,
        },
      ],
    },
  },
}
