{
  "name": "posterium-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "prebuild-push": "npm run clean",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "wrangler deploy --env production",
    "deploy:staging": "wrangler deploy --env staging",
    "release:staging": "npm run typecheck && npm run test && npm run build && npm run deploy:staging",
    "cf:dev": "wrangler dev"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.9",
    "@hello-pangea/dnd": "^18.0.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "workbox-window": "^7.4.0"
  },
  "devDependencies": {
    "skills": "^1.5.17",
    "@astrojs/markdown-remark": "^7.0.1",
    "@astrojs/react": "^5.0.1",
    "@astrojs/sitemap": "^3.7.1",
    "@tailwindcss/vite": "^4.2.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "astro": "^6.0.8",
    "astro-compress": "^2.4.0",
    "prettier": "^3.8.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.2",
    "workbox-build": "^7.4.0",
    "wrangler": "^4.73.0"
  },
  "overrides": {
    "@babel/plugin-transform-modules-systemjs": "7.29.0",
    "rollup": "4.59.0",
    "yargs-parser": "21.1.1"
  }
}
