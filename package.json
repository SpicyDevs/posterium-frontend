{
  "name": "posterium-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "prebuild-push": "npm run clean",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "wrangler deploy --env production",
    "deploy:staging": "wrangler deploy --env staging",
    "release:staging": "npm run typecheck && npm run test && npm run build && npm run deploy:staging",
    "cf:dev": "wrangler dev"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@hello-pangea/dnd": "^18.0.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "skills": "^1.5.22",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@astrojs/markdown-remark": "^7.2.2",
    "@astrojs/react": "^6.0.2",
    "@astrojs/sitemap": "^3.7.3",
    "@rollup/rollup-win32-x64-msvc": "^4.62.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "astro": "^7.1.6",
    "astro-compress": "^2.4.3",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "workbox-build": "^7.4.1",
    "wrangler": "^4.117.0"
  },
  "overrides": {
    "@babel/plugin-transform-modules-systemjs": "7.29.7"
  }
}