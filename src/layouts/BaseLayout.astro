---
import PageSEO from '@/seo/PageSEO.astro';
import { SEO_DEFAULTS } from '@/constants/site';
import type { PageSEOMetadata } from '@/types/seo';

interface Props {
  seo: PageSEOMetadata;
  bodyClass?: string;
}

const {
  seo,
  bodyClass,
} = Astro.props;

const pageSeo = {
  ...seo,
  robots: seo.robots || SEO_DEFAULTS.robots,
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link rel="alternate" hreflang="en" href="https://posterium.xyz" />

    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/icon-512.png" />
    <link rel="apple-touch-icon" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" sizes="512x512" href="/icon-512.png" />

    <PageSEO meta={pageSeo} />

    <!-- Self-hosted fonts (preload critical display+body fonts) -->
    <link rel="preload" href="/fonts/bebas-neue-400-normal-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/plus-jakarta-sans-400-normal-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/fonts/fonts.css" />

    <script>
      import '@/scripts/agent-context';
    </script>

    <script>
      import '@/scripts/web-vitals';
    </script>

    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <noscript>
      <div style="font-family: sans-serif; max-width: 700px; margin: 40px auto; padding: 20px;">
        <h1>Posterium - Free Movie &amp; TV Poster Generator with Rating Badges</h1>
        <p>Generate custom movie and TV show posters with live rating badges from IMDb, Rotten Tomatoes, Metacritic, TMDB — all from a single API URL.</p>
        <p>Visit <a href="#">posterium.xyz/build</a> to open the visual editor.</p>
      </div>
    </noscript>
    <slot />
    <slot name="related" />
  </body>
</html>
